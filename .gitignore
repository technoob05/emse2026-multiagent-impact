# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
.env
.pytest_cache/

# Scratch space. Working notes worth keeping live in docs/notes/ instead.
tmp/
notebooks/.cache/

# Derived analysis products. Regenerated by scripts/analysis/; the archived
# artifact ships them separately.
outputs/cache/
outputs/figures/*
outputs/tables/*.csv
outputs/tables/*.parquet

# Third-party data acquisitions, pinned by manifest rather than committed.
external_data/downloads/
external_data/source_repositories/
external_data/cache/

# Generated deliverables. Rebuild with scripts/build_submission.ps1.
build/qa/
build/figures/*.png
build/submission/

# LaTeX intermediates
paper/manuscript/*.aux
paper/manuscript/*.bbl
paper/manuscript/*.blg
paper/manuscript/*.fdb_latexmk
paper/manuscript/*.fls
paper/manuscript/*.log
paper/manuscript/*.out
paper/manuscript/main.pdf
paper/manuscript/technical_appendix.pdf

# ---------------------------------------------------------------------------
# NEVER PUBLISH. These de-blind the human-coding audits or identify authors.
# The appendix commits to excluding private coder keys from any public release;
# these rules are how that commitment is enforced.
# ---------------------------------------------------------------------------
outputs/**/private/
outputs/**/private_record_key.csv
outputs/**/private_sampling_key.csv
outputs/**/audit_key_do_not_share_before_coding.csv
outputs/**/*_answer_key.csv
docs/audits/AUTHOR_METADATA_AUDIT_*.md

# Ad-hoc exploration scratch. Promote anything worth keeping into a real
# analysis script under scripts/analysis/ first.
outputs/_exploration/
